#!/usr/bin/env bash
# deploy — ship this checkout's control plane to both hosts and (re)start weaver.service there.
# The guest daemon goes along; a VM picks it up the next time it boots.
# Secrets (password, secret_key_base) come from ~/weaver-ca/weaver.env, outside the repo.
set -e
cd "$(dirname "$0")/.."
hosts=(1 2)
declare -A ip
for h in "${hosts[@]}"; do
  ip[$h]=$(aws ec2 describe-instances --region ap-southeast-1 \
    --filters Name=tag:Name,Values=weaver-$h Name=instance-state-name,Values=running \
    --query 'Reservations[0].Instances[0].PrivateIpAddress' --output text)
done
peers=$(for h in "${hosts[@]}"; do printf 'weaver@%s,' "${ip[$h]}"; done); peers=${peers%,}
[ -f .cookie ] || (umask 077; head -c 24 /dev/urandom | base64 | tr -d '/+=' > .cookie)
tar czf /tmp/weaver-app.tgz mix.exs mix.lock config lib host priv
(cd guest && GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -ldflags='-s -w' -o weaver-guest .)

for h in "${hosts[@]}"; do
  cat > /tmp/weaver.service <<U
[Unit]
Description=Weaver control plane node
After=network-online.target
[Service]
User=ubuntu
WorkingDirectory=/opt/weaver/app
Environment=MIX_ENV=prod HOME=/home/ubuntu WEAVER_PEERS=$peers
EnvironmentFile=/etc/weaver/weaver.env
ExecStart=/usr/local/bin/elixir --name weaver@${ip[$h]} --erl "-kernel inet_dist_listen_min 9100 inet_dist_listen_max 9105" -S mix run --no-halt
Restart=always
[Install]
WantedBy=multi-user.target
U
  bin/put $h /tmp/weaver-app.tgz /opt/weaver/app.tgz >/dev/null
  bin/put $h /tmp/weaver.service /opt/weaver/weaver.service >/dev/null
  bin/put $h guest/weaver-guest /opt/weaver/weaver-guest >/dev/null
  bin/put $h ~/weaver-ca/weaver.env /opt/weaver/weaver.env.new >/dev/null
  bin/put $h .cookie /home/ubuntu/.erlang.cookie.new >/dev/null
  bin/w $h 'set -e
install -m 400 ~/.erlang.cookie.new ~/.erlang.cookie && rm ~/.erlang.cookie.new
sudo install -d -m 755 /etc/weaver && sudo install -m 600 /opt/weaver/weaver.env.new /etc/weaver/weaver.env && rm /opt/weaver/weaver.env.new
rm -rf /opt/weaver/app && mkdir -p /opt/weaver/app && tar xzf /opt/weaver/app.tgz -C /opt/weaver/app
install -m 755 /opt/weaver/app/host/vm.sh /opt/weaver/vm.sh
cd /opt/weaver/app && export MIX_ENV=prod && mix deps.get --only prod >/dev/null && mix compile >/dev/null
sudo install -m 644 /opt/weaver/weaver.service /etc/systemd/system/weaver.service
sudo systemctl daemon-reload && sudo systemctl enable -q weaver && sudo systemctl restart weaver
sleep 3; echo "weaver-'$h': $(systemctl is-active weaver)"'
done
rm -f /tmp/weaver-app.tgz /tmp/weaver.service
